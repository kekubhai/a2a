# ─── Database (Neon) ───────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/a2a?sslmode=require

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── EVM ───────────────────────────────────────────────────────
EVM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
EVM_PRIVATE_KEY=
EVM_CHAIN_ID=1

# ─── Solana ────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=

# ─── Orchestrator ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Verifier ──────────────────────────────────────────────────
VERIFIER_PORT=3001

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
API_KEY=change-me-in-production
