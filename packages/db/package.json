{
    "name": "@a2a/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "lint": "eslint src/",
        "typecheck": "tsc --noEmit",
        "clean": "if exist dist rmdir /s /q dist",
        "db:generate": "node ../../node_modules/.pnpm/drizzle-kit@0.31.10/node_modules/drizzle-kit/bin.cjs generate",
        "db:migrate": "node ../../node_modules/.pnpm/drizzle-kit@0.31.10/node_modules/drizzle-kit/bin.cjs migrate",
        "db:push": "node ../../node_modules/.pnpm/drizzle-kit@0.31.10/node_modules/drizzle-kit/bin.cjs push",
        "db:studio": "node ../../node_modules/.pnpm/drizzle-kit@0.31.10/node_modules/drizzle-kit/bin.cjs studio",
        "db:seed": "node ../../node_modules/.pnpm/tsx@4.23.0/node_modules/tsx/dist/cli.mjs src/seed.ts"
    },
    "dependencies": {
        "@a2a/shared-types": "workspace:*",
        "@neondatabase/serverless": "^0.10.4",
        "drizzle-orm": "^0.38.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "drizzle-kit": "^0.31.0",
        "typescript": "^5.3.3"
    }
}