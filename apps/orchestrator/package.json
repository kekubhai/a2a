{
  "name": "@a2a/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "dev": "node -r dotenv/config node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node -r dotenv/config dist/index.js",
    "lint": "eslint src/",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "clean": "if exist dist rmdir /s /q dist"
  },
  "dotenv": {
    "path": "../../.env"
  },
  "dependencies": {
    "@a2a/db": "workspace:*",
    "@a2a/redis": "workspace:*",
    "@a2a/sdk": "workspace:*",
    "@a2a/shared-types": "workspace:*",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
