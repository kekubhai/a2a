{
  "name": "@a2a/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "agent:coder": "tsx src/runners/coder.ts",
    "agent:researcher": "tsx src/runners/researcher.ts",
    "agent:reviewer": "tsx src/runners/reviewer.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a2a/db": "workspace:*",
    "@a2a/redis": "workspace:*",
    "@a2a/sdk": "workspace:*",
    "@a2a/shared-types": "workspace:*",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
